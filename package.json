{
  "name": "cloudflow",
  "private": true,
  "version": "0.1.0",
  "description": "Distributed workflow orchestration platform",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/worker",
    "dev:web": "npm run dev -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:api": "node scripts/bundle.mjs api",
    "build:worker": "node scripts/bundle.mjs worker",
    "stack:up": "docker compose -f docker-compose.stack.yml up --build -d",
    "stack:down": "docker compose -f docker-compose.stack.yml down",
    "stack:logs": "docker compose -f docker-compose.stack.yml logs -f --tail=100",
    "smoke:stack": "node scripts/smoke-stack.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
