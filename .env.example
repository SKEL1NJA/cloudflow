POSTGRES_USER=cloudflow
POSTGRES_PASSWORD=cloudflow_dev_password
POSTGRES_DB=cloudflow
POSTGRES_PORT=5432
REDIS_PORT=6379

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://cloudflow:cloudflow_dev_password@localhost:5432/cloudflow
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-this-with-a-long-random-secret-value
JWT_EXPIRES_IN=1h
TEST_DATABASE_URL=postgresql://cloudflow:cloudflow_dev_password@127.0.0.1:5432/cloudflow_test

HTTP_ALLOW_PRIVATE_NETWORK=false

WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_METRICS_PORT=9101
RECONCILER_INTERVAL_MS=30000
RECONCILER_GRACE_MS=60000
RECONCILER_STUCK_RUNNING_MS=600000